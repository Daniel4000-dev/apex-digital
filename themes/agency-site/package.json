{
  "name": "agency-site",
  "version": "1.0.0",
  "description": "Custom classic WordPress theme for a fictional digital marketing agency",
  "main": "index.php",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/src/css/input.css -o ./assets/dist/css/style.css --minify",
    "watch:css": "tailwindcss -i ./assets/src/css/input.css -o ./assets/dist/css/style.css --watch",
    "build:campaign": "gulp build",
    "watch:campaign": "gulp watch",
    "build": "npm run build:css && npm run build:campaign",
    "lint:js": "npx eslint assets/dist/js/main.js"
  },
  "keywords": [
    "wordpress",
    "theme",
    "agency",
    "tailwind"
  ],
  "author": "Antigravity",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "foundation-sites": "^6.9.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "postcss": "^8.4.49",
    "sass": "^1.107.1",
    "tailwindcss": "^3.4.19"
  }
}