{# Apex Digital — Legacy Component Fixture #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Legacy Fixture</title>
  <link rel="stylesheet" href="css/main.css">
</head>
<body>

  <div class="legacy-audit-wrapper">
    <div class="grid-container">
      <div class="audit-card">
        
        <div class="card-header">
          <span class="badge">{{ badge }}</span>
          <h2>{{ title }}</h2>
          <p>Prepared for {{ client_industry }} | Target: {{ target_url }}</p>
        </div>

        <div class="card-body">
          <div class="metric-grid">
            {% for metric in metrics %}
              <div class="metric-cell {{ metric.status }}">
                <div class="metric-label">{{ metric.label }}</div>
                <div class="metric-value">{{ metric.value }}</div>
              </div>
            {% endfor %}
          </div>

          <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin-bottom: 16px;">
            Key Diagnostic Deliverables:
          </h3>

          <ul class="deliverables-list">
            {% for item in deliverables %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>

          <div style="text-align: center; margin-top: 24px;">
            <a href="{{ cta_link }}" class="btn-legacy">{{ cta_text }} &rarr;</a>
          </div>
        </div>

      </div>
    </div>
  </div>

</body>
</html>
