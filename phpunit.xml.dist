<?xml version="1.0"?>
<phpunit
    bootstrap="tests/phpunit/bootstrap.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
>
    <testsuites>
        <testsuite name="Agency Site Unit Tests">
            <file>tests/phpunit/AgencySiteTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
